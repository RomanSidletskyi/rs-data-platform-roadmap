# Copy to p10.env (ignored by Git), fill in, then: set -a; source p10.env; set +a

SNOW_CONNECTION=p10
# Account identifier for the Airflow connection, for example myorg-myaccount
SNOWFLAKE_ACCOUNT=
# Key pair of the Airflow service user P10_AIRFLOW_SVC (QUICKSTART step 3)
P10_KEYS_DIR="$HOME/.snowflake/keys"
P10_AIRFLOW_PUBLIC_KEY_FILE="$HOME/.snowflake/keys/p10_airflow.pub"

# Where Airflow lands GH Archive files: internal (Snowflake stage, no cloud account), azure, or aws
P10_LANDING=internal
# DAG start_date: the earliest hour a backfill may reach. With catchup off, the scheduler itself
# only starts from the latest finished hour when you unpause the DAG.
P10_START_DATE=2025-01-01
# Days of events kept in STG after they are archived and verified; RAW days kept after archive
P10_HOT_DAYS=30
P10_RAW_DAYS=2

# Azure (P10_LANDING=azure): azure/01_provision.sh prints the values below it
P10_RG=rg-p10-gharchive
P10_LOCATION=
P10_STORAGE_ACCOUNT=
AZURE_TENANT_ID=
P10_AIRFLOW_SP_APP_ID=
P10_AIRFLOW_SP_SECRET=

# AWS (P10_LANDING=aws): aws/01_provision.sh prints the values below it
P10_BUCKET=
P10_REGION=
P10_AWS_ACCOUNT_ID=
P10_AIRFLOW_AWS_ACCESS_KEY_ID=
P10_AIRFLOW_AWS_SECRET_ACCESS_KEY=
