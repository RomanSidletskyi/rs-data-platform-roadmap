# Copy to p11.env (ignored by Git), fill in, then: set -a; source p11.env; set +a

SNOW_CONNECTION=p11
# Local landing root for --target local and ./upload.sh (internal-stage mode)
P11_DATA_DIR="$HOME/data/p11_markets"
# ISO3 codes with an HDX slug in ingest/markets_ingest/sources.py
P11_COUNTRIES=KEN,NGA,ETH,BGD,IND,TUR
# Key pair of the Power BI service user P11_POWERBI_SVC (QUICKSTART step 3)
P11_POWERBI_PUBLIC_KEY_FILE="$HOME/.snowflake/keys/p11_powerbi.pub"

# Azure: azure/01_provision.sh prints the values it creates
P11_RG=rg-p11-markets
P11_LOCATION=
P11_STORAGE_ACCOUNT=
P11_FUNCTION_APP=
AZURE_TENANT_ID=

# AWS: aws/01_provision.sh prints the values it creates
P11_BUCKET=
P11_REGION=
P11_AWS_ACCOUNT_ID=
