# Copy to p14.env (ignored by Git), fill in, then: set -a; source p14.env; set +a

# Snowflake CLI connection for your own user (see setup guide, Snowflake CLI)
SNOW_CONNECTION=p14
P14_ALERT_EMAIL=
# <orgname>-<account_name>, from Snowsight account details
SNOWFLAKE_ACCOUNT_IDENTIFIER=

# Key pair for the connector service user P14_KAFKA_SVC (not your personal key)
P14_CONNECTOR_PRIVATE_KEY_FILE="$HOME/.snowflake/keys/p14_kafka_svc.p8"
P14_CONNECTOR_PUBLIC_KEY_FILE="$HOME/.snowflake/keys/p14_kafka_svc.pub"

# Local Kafka lab
CONNECT_URL=http://localhost:8083
P14_CONNECTOR_NAME=p14_wiki_snowflake_sink
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=wiki.recentchange

WIKI_USER_AGENT="p14-learning/1.0 (you@example.com)"
