# Copy to p09.env (ignored by Git), fill in, then: set -a; source p09.env; set +a

SNOW_CONNECTION=p09
P09_ALERT_EMAIL=
# Absolute path outside the repository; the extractor writes coinbase/ and fred/ here
P09_DATA_DIR="$HOME/data/p09_markets"
P09_LOOKBACK_DAYS=3

# dbt profile variables (profiles.yml.example), for your own user with a key pair
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH="$HOME/.snowflake/keys/p09_dev.p8"
DBT_PROFILES_DIR="$HOME/.dbt"

# Public keys of the two service users (core/05_service_users.sql); private keys go to GitHub secrets only
P09_CI_PUBLIC_KEY_FILE="$HOME/.snowflake/keys/p09_ci.pub"
P09_PIPELINE_PUBLIC_KEY_FILE="$HOME/.snowflake/keys/p09_pipeline.pub"
