# Copy to p08.env (ignored by Git), fill in, then: set -a; source p08.env; set +a
# Used by run_sql.sh, the azure/ scripts, and the producer.

SNOW_CONNECTION=p08

# Azure (primary)
P08_RG=rg-p08-social
P08_LOCATION=westeurope
P08_STORAGE_ACCOUNT=
P08_CONTAINER=landing
P08_QUEUE=snowpipe-p08
# Printed by azure/01_provision.sh
AZURE_TENANT_ID=
# The producer reuses the P04 sink arguments, which read these names
P04_AZURE_ACCOUNT_URL="https://${P08_STORAGE_ACCOUNT}.blob.core.windows.net"
P04_CONTAINER=landing

# AWS variant (leave empty when using Azure)
AWS_ACCOUNT_ID=
P08_BUCKET=
P08_REGION=
P04_BUCKET="${P08_BUCKET}"
