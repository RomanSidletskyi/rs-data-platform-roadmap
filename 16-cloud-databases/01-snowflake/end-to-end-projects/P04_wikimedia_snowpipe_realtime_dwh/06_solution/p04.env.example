# Copy to p04.env (ignored by Git), fill in, then: set -a; source p04.env; set +a
# Used by run_sql.sh, the azure/ and aws/ scripts, and the producer.

# Snowflake CLI connection name from ~/.snowflake/config.toml
SNOW_CONNECTION=p04
# Verified email of your Snowflake user, for the freshness alert
P04_ALERT_EMAIL=

# Azure (primary)
P04_RG=rg-p04-wiki
P04_LOCATION=westeurope
P04_STORAGE_ACCOUNT=
P04_CONTAINER=landing
P04_QUEUE=snowpipe-p04
# Printed by azure/01_provision.sh
AZURE_TENANT_ID=
P04_AZURE_ACCOUNT_URL="https://${P04_STORAGE_ACCOUNT}.blob.core.windows.net"

# Producer: Wikimedia asks for a descriptive User-Agent with a contact
WIKI_USER_AGENT="p04-learning/1.0 (you@example.com)"

# AWS variant (leave empty when using Azure)
AWS_PROFILE=
AWS_ACCOUNT_ID=
P04_BUCKET=
P04_REGION=
