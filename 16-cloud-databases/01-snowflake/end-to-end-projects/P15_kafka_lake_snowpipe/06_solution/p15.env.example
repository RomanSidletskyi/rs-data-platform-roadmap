# Copy to p15.env (ignored by Git), fill in, then: set -a; source p15.env; set +a

SNOW_CONNECTION=p15
P15_ALERT_EMAIL=

# Azure (primary)
P15_RG=rg-p15-lake
P15_LOCATION=westeurope
P15_STORAGE_ACCOUNT=
P15_CONTAINER=landing
P15_QUEUE=snowpipe-p15
# Printed by azure/01_provision.sh
AZURE_TENANT_ID=

# Kafka lab
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=wiki.recentchange
P15_CONSUMER_GROUP=p15-lake-writer
WIKI_USER_AGENT="p15-learning/1.0 (you@example.com)"

# AWS variant (leave empty when using Azure)
AWS_PROFILE=
AWS_ACCOUNT_ID=
P15_BUCKET=
