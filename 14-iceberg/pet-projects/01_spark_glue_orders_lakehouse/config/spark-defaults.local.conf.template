spark.jars.packages org.apache.iceberg:iceberg-spark-runtime-3.5_2.12:1.10.1,org.apache.iceberg:iceberg-aws-bundle:1.10.1
spark.sql.extensions org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions
spark.sql.catalog.lab org.apache.iceberg.spark.SparkCatalog
spark.sql.catalog.lab.type hadoop
spark.sql.catalog.lab.warehouse s3://iceberg-warehouse/warehouse
spark.sql.catalog.lab.io-impl org.apache.iceberg.aws.s3.S3FileIO
spark.sql.catalog.lab.s3.endpoint http://minio:9000
spark.sql.catalog.lab.s3.path-style-access true
spark.sql.catalog.lab.s3.access-key-id minioadmin
spark.sql.catalog.lab.s3.secret-access-key minioadmin123
spark.hadoop.fs.s3a.endpoint http://minio:9000
spark.hadoop.fs.s3a.access.key minioadmin
spark.hadoop.fs.s3a.secret.key minioadmin123
spark.hadoop.fs.s3a.impl org.apache.hadoop.fs.s3a.S3AFileSystem
spark.hadoop.fs.s3a.path.style.access true
spark.hadoop.fs.s3a.connection.ssl.enabled false